{"wypowiedz_id": "r9b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: spór o to, kto przyjął politykę", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "To wy podpisaliście pakiet Fit for 55 w Brukseli, a on od 2027 r. obejmie opłatami za emisję węgiel i gaz spalane w domowych kotłach, więc ogrzewanie zdrożeje.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1462, "tokeny_wy": 70, "num_ctx": 16384, "blad": null, "sekundy": 0.84}
{"wypowiedz_id": "r10a", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: cel polityki klimatycznej", "oczekiwane": "0", "zrodlo": "", "klimat": 0, "fragment": "Komisja Europejska zaproponowała cel redukcji emisji na 2040 r.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1444, "tokeny_wy": 35, "num_ctx": 16384, "blad": null, "sekundy": 0.57}
{"wypowiedz_id": "r10b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: cel polityki klimatycznej", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Ten cel oznacza wygaszenie polskiej chemii, bo nie ma dziś technologii, które pozwolą jej tak szybko obniżyć emisje.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1448, "tokeny_wy": 44, "num_ctx": 16384, "blad": null, "sekundy": 0.54}
