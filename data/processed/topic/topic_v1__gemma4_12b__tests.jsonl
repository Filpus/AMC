{"wypowiedz_id": "r1b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: klimat w innym znaczeniu", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Do tego zmiana klimatu już dziś powoduje coraz dłuższe susze, które uderzają w rolników, a projekt w ogóle tego nie uwzględnia.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1458, "tokeny_wy": 50, "num_ctx": 16384, "blad": null, "sekundy": 0.73}
