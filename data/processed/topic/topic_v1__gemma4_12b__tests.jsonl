{"wypowiedz_id": "r2b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: nazwa urzędu", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Ulewy takie jak ta, która zalała nasze miasto, będą się zdarzać coraz częściej, bo klimat się ociepla, a kanalizacja nie jest na to przygotowana.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1468, "tokeny_wy": 60, "num_ctx": 16384, "blad": null, "sekundy": 0.73}
{"wypowiedz_id": "r3a", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: tło", "oczekiwane": "0", "zrodlo": "", "klimat": 0, "fragment": "W dobie zmian klimatu musimy mądrze gospodarować pieniędzmi publicznymi.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1453, "tokeny_wy": 35, "num_ctx": 16384, "blad": null, "sekundy": 0.55}
{"wypowiedz_id": "r3b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: tło", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Naukowcy IPCC ostrzegają, że bez szybkiej redukcji emisji ocieplenie przekroczy 1,5 stopnia, a koszty adaptacji będą rosły.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1477, "tokeny_wy": 60, "num_ctx": 16384, "blad": null, "sekundy": 0.72}
{"wypowiedz_id": "r4a", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: epitet", "oczekiwane": "0", "zrodlo": "", "klimat": 0, "fragment": "Wasz podatek cukrowy to kolejna religia, tak jak klimatyzm: najpierw wiara, potem rachunek dla obywateli.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1458, "tokeny_wy": 52, "num_ctx": 16384, "blad": null, "sekundy": 0.69}
{"wypowiedz_id": "r4b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: epitet", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Wmawiacie ludziom, że to człowiek ociepla klimat, choć klimat zmieniał się zawsze, także wtedy, gdy nie było fabryk. A rachunek za tę wiarę zapłacą obywatele w cenach prądu.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1456, "tokeny_wy": 66, "num_ctx": 16384, "blad": null, "sekundy": 0.86}
{"wypowiedz_id": "r5a", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: klęska bez odniesienia", "oczekiwane": "0", "zrodlo": "", "klimat": 0, "fragment": "", "fragment_w_tekscie": null, "obciete": false, "tokeny_we": 1455, "tokeny_wy": 13, "num_ctx": 16384, "blad": null, "sekundy": 0.41}
{"wypowiedz_id": "r5b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: klęska bez odniesienia", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Takich ulew będzie przybywać, bo cieplejsza atmosfera zatrzymuje więcej wody.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1463, "tokeny_wy": 34, "num_ctx": 16384, "blad": null, "sekundy": 0.5}
