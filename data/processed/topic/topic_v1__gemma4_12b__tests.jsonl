{"wypowiedz_id": "r6b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: energia bez emisji", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Ceny prądu dla gospodarstw domowych wzrosną od stycznia o 30%, bo za każdą tonę CO2 z elektrowni węglowych płacimy coraz więcej w systemie ETS.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1457, "tokeny_wy": 58, "num_ctx": 16384, "blad": null, "sekundy": 0.77}
{"wypowiedz_id": "r7a", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: OZE bez emisji", "oczekiwane": "0", "zrodlo": "", "klimat": 0, "fragment": "Nowe zasady rozliczania prosumentów są niekorzystne dla właścicieli paneli fotowoltaicznych. Okres zwrotu inwestycji wydłuży się z 6 do 10 lat.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1451, "tokeny_wy": 57, "num_ctx": 16384, "blad": null, "sekundy": 0.74}
{"wypowiedz_id": "r7b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: OZE bez emisji", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "Nowe zasady rozliczania prosumentów spowolnią rozwój fotowoltaiki, a to przecież najtańszy sposób na ograniczenie emisji z naszej energetyki.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1448, "tokeny_wy": 54, "num_ctx": 16384, "blad": null, "sekundy": 0.68}
{"wypowiedz_id": "r8a", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: odniesienie do innego mówcy", "oczekiwane": "0", "zrodlo": "", "klimat": 0, "fragment": "Pan poseł pytał w swoim wystąpieniu także o politykę klimatyczną rządu.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1453, "tokeny_wy": 33, "num_ctx": 16384, "blad": null, "sekundy": 0.57}
{"wypowiedz_id": "r8b", "model": "gemma4:12b", "prompt": "topic_v1", "komputer": "DESKTOP-7J30RB1", "regula": "para: odniesienie do innego mówcy", "oczekiwane": "1", "zrodlo": "", "klimat": 1, "fragment": "To nieprawda: każda tona CO2 mniej spowalnia ocieplenie, niezależnie od tego, gdzie ją zaoszczędzimy.", "fragment_w_tekscie": 1.0, "obciete": false, "tokeny_we": 1484, "tokeny_wy": 47, "num_ctx": 16384, "blad": null, "sekundy": 0.68}
