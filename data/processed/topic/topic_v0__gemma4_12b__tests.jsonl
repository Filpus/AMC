{"wypowiedz_id": "p1", "model": "gemma4:12b", "prompt": "topic_v0", "komputer": "DESKTOP-7J30RB1", "regula": "przykład z promptu", "oczekiwane": "1", "zrodlo": "9_61_2022-09-15_46", "klimat": 1, "fragment": "Zmiana klimatu powoduje, że pojawiające się opady są bardzo intensywne i zwykle rozdzielają dłuższe okresy bezdeszczowe. Taka charakterystyka opadów przyczynia się z kolei do intensyfikacji zjawiska suszy.", "fragment_w_tekscie": 1.0, "blad": null, "obciete": false, "sekundy": 1.13, "tokeny_we": 2161, "tokeny_wy": 75, "num_ctx": 16384}
