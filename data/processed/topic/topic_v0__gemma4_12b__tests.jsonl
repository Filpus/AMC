{"wypowiedz_id": "k91_2", "model": "gemma4:12b", "prompt": "topic_v0", "komputer": "DESKTOP-7J30RB1", "regula": "codebook 9.1", "oczekiwane": "1", "zrodlo": "10_18_2024-09-25_107", "klimat": 1, "fragment": "Naukowcy są tutaj jednoznaczni, że nie chodzi o spory na temat klimatu, tylko chodzi o to, jak będą wyglądały zjawiska pogodowe w ciągu najbliższych kilkunastu czy nawet kilkudziesięciu lat. A sytuacja będzie krytyczna, jeśli chodzi o efekty tych zmian klimatycznych.", "fragment_w_tekscie": 1.0, "blad": null, "obciete": true, "sekundy": 3.35, "tokeny_we": 6315, "tokeny_wy": 90, "num_ctx": 16384}
